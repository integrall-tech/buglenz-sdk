{
  "version": 1,
  "separators": ["_", "-", " ", "."],
  "exact": [
    "accesstoken", "apikey", "auth", "authorization", "cardnumber", "cartao", "cnpj", "cookie",
    "cpf", "credentials", "creditcard", "csrf", "csrftoken", "idtoken", "ipaddress", "passwd",
    "password", "privatekey", "pwd", "refreshtoken", "remoteaddr", "rg", "secret", "senha",
    "session", "sessionid", "setcookie", "token", "xforwardedfor", "xrealip", "xsrftoken"
  ],
  "contains": [
    "apikey", "authorization", "cardnumber", "cookie", "creditcard", "passwd", "password",
    "privatekey", "secret", "senha", "token"
  ],
  "containsExcept": { "token": ["tokens"] },
  "identifier": {
    "suffix": ["id"],
    "exact": ["dist", "endtimestamp", "release", "sentat", "starttimestamp", "timestamp"]
  }
}
